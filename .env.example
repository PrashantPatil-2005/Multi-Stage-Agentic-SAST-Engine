# PREPARE stage configuration (all optional; defaults shown below)

# Root workspace for fetched repositories and snapshots
SAST_WORKSPACE_DIR=workspace

# Database connection (SQLite for local dev; PostgreSQL via e.g.
# postgresql+psycopg2://user:pass@localhost:5432/sast)
SAST_DATABASE_URL=sqlite:///./sast.db

# Ingestion limits
SAST_MAX_FILE_SIZE_BYTES=1048576
SAST_MAX_TOTAL_SIZE_BYTES=52428800
SAST_MAX_FILES=5000
SAST_GIT_CLONE_TIMEOUT_SECONDS=60

# Logging
SAST_LOG_LEVEL=INFO

# LLM provider for the VALIDATE stage (Hugging Face Inference API router)
# Placeholders only - never commit a real token.
LLM_PROVIDER=huggingface
LLM_BASE_URL=https://router.huggingface.co/v1
LLM_API_KEY=your_huggingface_token_here
LLM_MODEL=your-model-id
LLM_TIMEOUT_SECONDS=30
