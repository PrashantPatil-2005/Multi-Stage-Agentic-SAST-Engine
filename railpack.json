{
  "$schema": "https://schema.railpack.com",
  "packages": {
    "node": "22",
    "python": "3.12"
  },
  "steps": {
    "build-frontend": {
      "commands": [
        "cd frontend && npm ci --prefer-offline --no-audit --no-fund",
        "cd frontend && npm run build"
      ]
    },
    "install-backend": {
      "inputs": [
        { "step": "packages:mise" },
        { "step": "build-frontend" }
      ],
      "commands": [
        "cd backend && pip install --no-cache-dir ."
      ]
    }
  }
}
